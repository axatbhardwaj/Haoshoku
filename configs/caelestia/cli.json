{
  "toggles": {
    "communication": {
      "discord": {
        "enable": false
      },
      "signal": {
        "enable": true,
        "match": [{"class": "signal"}],
        "command": ["signal-desktop"],
        "move": true
      },
      "whatsapp-web": {
        "enable": true,
        "match": [{"class": "brave-web.whatsapp.com__-Default"}],
        "command": ["/home/xzat/.local/bin/whatsapp-web"],
        "move": true
      }
    },
    "1password": {
      "1password": {
        "enable": true,
        "match": [{"class": "1password"}],
        "command": ["1password"],
        "move": true
      }
    },
    "music": {
      "spotify": {
        "enable": true,
        "match": [{"class": "spotify"}, {"class": "Spotify"}, {"initialTitle": "Spotify"}, {"initialTitle": "Spotify Free"}],
        "command": ["spotify"],
        "move": true
      }
    },
    "sysmon": {
      "btop": {
        "enable": true,
        "match": [{"class": "dev.warp.Warp", "title": "btop", "workspace": {"name": "special:sysmon"}}],
        "command": ["xdg-terminal-exec", "--", "env", "LC_ALL=C.UTF-8", "fish", "-C", "exec btop"]
      }
    },
    "brave-personal": {
      "brave-personal": {
        "enable": true,
        "match": [{"class": "brave-browser", "title": "Flux"}],
        "command": ["brave", "--profile-directory=Default"],
        "move": true
      }
    },
    "brave-work": {
      "brave-work": {
        "enable": true,
        "match": [{"class": "brave-browser", "title": "Defi"}],
        "command": ["brave", "--profile-directory=Profile 1"],
        "move": true
      }
    }
  },
  "wallpaper": {
    "postHook": "sudo /usr/share/sddm/themes/caelestia/scripts/sync.sh --posthook"
  },
  "theme": {
    "postHook": "sudo /usr/share/sddm/themes/caelestia/scripts/sync.sh --posthook"
  }
}
