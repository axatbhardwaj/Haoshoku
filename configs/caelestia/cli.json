{
  "toggles": {
    "communication": {
      "discord": {
        "enable": false
      },
      "vesktop": {
        "enable": false
      },
      "signal": {
        "enable": true,
        "match": [{"class": "signal"}],
        "command": ["signal-desktop"],
        "move": true
      },
      "whatsapp-web": {
        "enable": true,
        "match": [{"class": "brave-hnpfjngllnobngcgfapefoaidbinmjnm-Default"}],
        "command": ["/opt/brave-bin/brave", "--profile-directory=Default", "--app-id=hnpfjngllnobngcgfapefoaidbinmjnm"],
        "move": true
      }
    },
    "1password": {
      "1password": {
        "enable": true,
        "match": [{"class": "1password"}],
        "command": ["1password"],
        "move": true
      }
    },
    "music": {
      "spotify": {
        "enable": true,
        "match": [{"class": "spotify"}, {"class": "Spotify"}, {"initialTitle": "Spotify"}, {"initialTitle": "Spotify Free"}],
        "command": ["spotify"],
        "move": true
      }
    },
    "sysmon": {
      "btop": {
        "enable": true,
        "match": [{"class": "btop", "title": "btop", "workspace": {"name": "special:sysmon"}}],
        "command": ["foot", "-a", "btop", "-T", "btop", "env", "LC_ALL=C.UTF-8", "fish", "-C", "exec btop"]
      }
    },
    "brave-personal": {
      "brave-personal": {
        "enable": true,
        "match": [{"class": "brave-browser", "title": "Flux"}],
        "command": ["brave", "--profile-directory=Default"],
        "move": true
      }
    },
    "brave-work": {
      "brave-work": {
        "enable": true,
        "match": [{"class": "brave-browser", "title": "Defi"}],
        "command": ["brave", "--profile-directory=Profile 1"],
        "move": true
      }
    },
    "claude": {
      "claude": {
        "enable": true,
        "match": [{"class": "kitty-claude"}],
        "command": ["kitty", "--class=kitty-claude", "--directory=/home/xzat", "-e", "/etc/xdg/quickshell/caelestia/assets/wrap_term_launch.sh", "claude", "-r", "io"],
        "move": true
      }
    }
  }
}
