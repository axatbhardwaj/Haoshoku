{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg": "#0F111A",
    "fg": "#E1E4F0",
    "black": "#546E7A",
    "red": "#FF5370",
    "green": "#C3E88D",
    "yellow": "#FFCB6B",
    "blue": "#82AAFF",
    "magenta": "#C792EA",
    "cyan": "#89DDFF",
    "white": "#FFFFFF",
    "neonGreen": "#B2FF59",
    "orange": "#F78C6C",
    "teal": "#00897B",
    "selection": "#1F2233",
    "guide": "#3B4252"
  },
  "theme": {
    "primary": { "dark": "teal", "light": "teal" },
    "secondary": { "dark": "blue", "light": "blue" },
    "accent": { "dark": "teal", "light": "teal" },
    "background": { "dark": "none", "light": "none" },
    "backgroundPanel": { "dark": "#1a1c25", "light": "#1a1c25" },
    "backgroundElement": { "dark": "selection", "light": "selection" },
    "text": { "dark": "fg", "light": "fg" },
    "textMuted": { "dark": "neonGreen", "light": "neonGreen" },
    "border": { "dark": "selection", "light": "selection" },
    "borderActive": { "dark": "teal", "light": "teal" },
    "error": { "dark": "red", "light": "red" },
    "warning": { "dark": "yellow", "light": "yellow" },
    "success": { "dark": "green", "light": "green" },
    "info": { "dark": "blue", "light": "blue" },
    "syntaxKeyword": { "dark": "magenta", "light": "magenta" },
    "syntaxString": { "dark": "green", "light": "green" },
    "syntaxFunction": { "dark": "blue", "light": "blue" },
    "syntaxVariable": { "dark": "fg", "light": "fg" },
    "syntaxComment": { "dark": "neonGreen", "light": "neonGreen" },
    "syntaxType": { "dark": "yellow", "light": "yellow" },
    "syntaxNumber": { "dark": "orange", "light": "orange" },
    "syntaxOperator": { "dark": "cyan", "light": "cyan" },
    "syntaxPunctuation": { "dark": "fg", "light": "fg" }
  }
}
