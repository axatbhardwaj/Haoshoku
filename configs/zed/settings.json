{
  "cli_default_open_behavior": "existing_window",
  "language_models": {
    "openai_compatible": {
      "NVIDIA": {
        "api_url": "https://integrate.api.nvidia.com/v1",
        "available_models": [
          {
            "name": "moonshotai/kimi-k2.5",
            "display_name": "Kimi K2.5",
            "max_tokens": 131072,
            "max_output_tokens": 8192,
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": true,
              "prompt_cache_key": false
            }
          }
        ]
      }
    }
  },
  "features": {
    "edit_prediction_provider": "zed"
  },
  "outline_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "right"
  },
  "autosave": "on_focus_change",
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry"
    },
    "opencode": {
      "default_model": "google/antigravity-claude-opus-4-5-thinking",
      "default_mode": "OpenAgent",
      "type": "extension",
      "favorite_models": [
        "google/antigravity-gemini-3-pro",
        "google/antigravity-claude-sonnet-4-5-thinking",
        "google/antigravity-claude-sonnet-4-5",
        "google/gemini-3-flash-preview",
        "google/antigravity-claude-opus-4-5-thinking",
        "google/antigravity-gemini-3-flash"
      ],
      "default_config_options": {},
      "favorite_config_option_values": {}
    }
  },
  "icon_theme": "Material Icon Theme",
  "project_panel": {
    "dock": "right"
  },
  "agent": {
    "dock": "left",
    "default_profile": "ask",
    "default_model": {
      "provider": "NVIDIA",
      "model": "moonshotai/kimi-k2.5"
    },
    "play_sound_when_agent_done": true,
    "always_allow_tool_actions": true,
    "model_parameters": []
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "Caelestia",
    "dark": "Caelestia"
  },
  "experimental.theme_overrides": {
    "background.appearance": "blurred",
    "background": "#05050599",
    "elevated_surface.background": "#05050599",
    "surface.background": "#05050599",
    "editor.background": "#05050599",
    "editor.gutter.background": "#05050599",
    "editor.subheader.background": "#0a0a0b99",
    "terminal.background": "#05050599",
    "panel.background": "#05050599",
    "status_bar.background": "#05050599",
    "title_bar.background": "#05050599",
    "title_bar.inactive_background": "#05050599",
    "toolbar.background": "#05050599",
    "tab_bar.background": "#05050599",
    "tab.active_background": "#05050599",
    "tab.inactive_background": "#05050599"
  }
}