[Desktop Entry]
Name=WhatsApp Web
Comment=Open WhatsApp in its isolated Brave Origin profile
Exec=sh -lc 'exec brave-origin --user-data-dir="$HOME/.config/brave-haoshoku/whatsapp" --app=https://web.whatsapp.com/'
Terminal=false
Type=Application
Categories=Network;InstantMessaging;
StartupWMClass=brave-web.whatsapp.com__-Default
