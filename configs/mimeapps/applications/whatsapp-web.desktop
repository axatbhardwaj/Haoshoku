[Desktop Entry]
Name=WhatsApp Web
Comment=Open WhatsApp in its isolated Chromium profile
Exec=sh -lc 'exec chromium --user-data-dir="$HOME/.config/chromium-haoshoku/whatsapp" --class=chromium-whatsapp --app=https://web.whatsapp.com/'
Terminal=false
Type=Application
Categories=Network;InstantMessaging;
StartupWMClass=chromium-whatsapp
