[Desktop Entry]
Version=1.0
Name=Chromium
GenericName=Web Browser
Comment=Chromium pinned to the flux profile so web apps share one session
Exec=haoshoku-chromium-flux %U
StartupNotify=true
Terminal=false
Icon=chromium
Type=Application
Categories=Network;WebBrowser;
MimeType=text/html;text/xml;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
