# Ghostty — Caelestia (mirrors ~/.config/zed/themes/caelestia.json)
#
# Every colour below is copied verbatim from the Zed "Caelestia" theme's
# terminal.* keys so Ghostty and Zed's integrated terminal render identically.
# Regenerate from the theme rather than hand-editing:
#   jq -r '.themes[0].style | to_entries[] | select(.key|startswith("terminal."))' \
#     ~/.config/zed/themes/caelestia.json

font-family = 0xProto Nerd Font Mono
font-size = 11

# 0.851 is Zed's `background` alpha (#050505D9). Hyprland composites the blur —
# decoration.conf sets it globally with ignore_opacity, and rules.conf layers a
# further 0.95 window opacity on top. background-blur here is the KDE/GTK path
# and is inert under Hyprland, so leaving it off avoids a second blur pass.
background-opacity = 0.85
background-blur = false

# Hyprland tiles this window; a GTK client-side titlebar would only waste rows.
window-decoration = none
window-padding-x = 4
window-padding-y = 4

# Zed: background #050505D9, editor.foreground / terminal.foreground #F5F5F6,
# border.focused / icon.accent #24BD5C (also OSC 12/17 in Caelestia's sequences).
background = #050505
foreground = #F5F5F6
cursor-color = #24BD5C
selection-background = #24BD5C
selection-foreground = #050505

# terminal.ansi.* — normal.
#
# Index 0 is the one value NOT taken from Zed. Caelestia renders the Zed theme
# from a different colour set than the terminal one: zed.json maps
# terminal.ansi.black to `surface`, which is also the window background, so SGR
# 30 would be invisible. Caelestia's own terminal palette (`term0`) lifts it to
# #343434, and that is what is used here and in sequences.txt. Zed's literal
# value is #050505 if you want the collision back.
palette = 0=#343434
palette = 1=#8affab
palette = 2=#8af797
palette = 3=#d0f9f4
palette = 4=#65eea0
palette = 5=#73fa90
palette = 6=#a0f9aa
palette = 7=#f5f5f6

# terminal.ansi.bright_*
palette = 8=#c9c9c9
palette = 9=#abf0c5
palette = 10=#a0f9aa
palette = 11=#a9daac
palette = 12=#85ef77
palette = 13=#bdffd4
palette = 14=#cefb97
palette = 15=#f5f5f6

# Zed maps ansi.white and ansi.bright_white to the same colour (onSurface), so
# bright white is not brighter here. Left as Zed has it — unlike the ansi.black
# collision above, nothing becomes unreadable.

# Claude Code: shift+enter inserts a newline instead of submitting.
keybind = shift+enter=text:\x1b\r

# Ghostty asks before closing a surface with a running process; kitty does not,
# and this is a tiling setup where windows get closed constantly.
confirm-close-surface = false
