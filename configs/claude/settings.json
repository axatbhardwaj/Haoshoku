  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "jq -c 'if (.tool_input.skill // \"\") | IN(\"superpowers:brainstorming\", \"superpowers:writing-plans\") then {hookSpecificOutput:{hookEventName:\"PreToolUse\",additionalContext:\"[output-contract] Working docs from this skill go to gitignored ./superpowers/ at the repo root as a SINGLE self-contained dark-mode HTML file (specs/YYYY-MM-DD-<topic>-design.html | plans/YYYY-MM-DD-<feature>.html) — never a tracked docs/ path, never markdown. Ensure /superpowers/ and agent-os/ are in .gitignore before writing. See ~/.claude/CLAUDE.md Working artifacts + Deliverables.\"},suppressOutput:true} else empty end'",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '[gate-check] 1) SKILLS: if any skill might apply to this message (even 1%), invoke it via the Skill tool before responding. 2) TODOS: unless this is pure conversation with zero tool work, TaskCreate the steps before starting - even a single-step task gets one todo, statuses updated live. 3) CODE: about to Edit/Write code? Re-check brainstorm/TDD gates first.'",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/xzat/.claude/hooks/routing-gate.sh",
            "timeout": 15,
            "statusMessage": "Checking routing gate..."
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "tldraw-offline",
        "hooks": [
          {
            "type": "command",
            "command": "sh '/home/xzat/skills/tldraw-offline/inject-server-context.sh' SubagentStart"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/xzat/.local/bin/claude-stay-awake --session-hook",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash /home/xzat/.claude/statusline-command.sh"
  },
