#!/usr/bin/env bash
set -euo pipefail

profile=""
if ! profile="$(
	hyprctl clients -j 2>/dev/null | jq -r '
		[
			.[]?
			| select(type == "object")
			| select(.class == "chromium-flux" or .class == "chromium-defi")
			| select((.focusHistoryID | type) == "number")
			| select(.focusHistoryID >= 0)
		]
		| sort_by(.focusHistoryID)
		| .[0].class // empty
	' 2>/dev/null
)"; then
	profile=""
fi

case "$profile" in
	chromium-defi) recipe="browser-defi" ;;
	*) recipe="browser-flux" ;;
esac

exec haoshoku-special-workspace "$recipe" "$@"
