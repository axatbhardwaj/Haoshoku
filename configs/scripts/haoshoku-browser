#!/usr/bin/env bash
set -euo pipefail

readonly FALLBACK_PROFILES='[{"id":"flux","class":"chromium-flux","monitor":"DP-1","default":true},{"id":"defi","class":"chromium-defi","monitor":"DP-1"}]'

load_profiles() {
	local config="$HOME/.haoshoku.json"
	if [[ -r "$config" ]] && jq -ce '
		def safe_id:
			type == "string" and test("^[A-Za-z0-9][A-Za-z0-9_-]*$");
		def safe_value:
			type == "string" and test("^[A-Za-z0-9][A-Za-z0-9_.-]*$");
		def valid_profile:
			type == "object"
			and (.id | safe_id)
			and (.class | safe_value)
			and (.monitor | safe_value)
			and (if has("default") then (.default | type == "boolean") else true end);
		def valid_registry:
			type == "array"
			and length > 0
			and all(.[]; valid_profile)
			and ([.[].id] | unique | length) == length
			and ([.[].class] | unique | length) == length
			and ([.[] | select(.default == true)] | length) == 1;
		if type == "object" and (.chromiumProfiles? | valid_registry)
		then .chromiumProfiles else empty end
	' "$config" 2>/dev/null; then
		return
	fi
	printf '%s\n' "$FALLBACK_PROFILES"
}

profiles="$(load_profiles)"
profile_id=""
if ! profile_id="$(
	hyprctl clients -j 2>/dev/null | jq -r '
		[
			.[]? as $client
			| select($client | type == "object")
			| select(($client.focusHistoryID | type) == "number")
			| select($client.focusHistoryID >= 0)
			| $profiles[]
			| select(.class == $client.class)
			| { id, focusHistoryID: $client.focusHistoryID }
		]
		| sort_by(.focusHistoryID)
		| .[0].id // empty
	' --argjson profiles "$profiles" 2>/dev/null
)"; then
	profile_id=""
fi

if [[ -z "$profile_id" ]]; then
	profile_id="$(jq -r '[.[] | select(.default == true)][0].id // "flux"' <<<"$profiles")"
fi

exec haoshoku-special-workspace browser "$profile_id" "$@"
