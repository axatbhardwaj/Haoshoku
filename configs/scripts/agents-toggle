#!/usr/bin/env sh
# Super+A: toggle the Ghostty "agents" window on its dedicated special:agents
# workspace.
#
# Ghostty opens one process per window and accepts --class, so this window
# carries a Wayland app_id nothing else uses. That is what collapsed the old Warp
# version of this script: Warp was a single warm multi-window process where every
# window was class dev.warp.Warp, so Hyprland's [workspace special:agents]
# execrule (which matches the PID it launched) missed whenever Warp was already
# running, and placement needed an address diff against a pre-spawn snapshot.
# A unique class removes both problems — the execrule lands, and identifying the
# window afterwards is a single lookup.
#
# One pane, running Claude. The Codex half was dropped back when this was a Warp
# tab config: Codex is started by hand when it is actually wanted. Ghostty has no
# declarative session or split format, so restoring a two-pane layout would mean
# running tmux or zellij inside the window.
WS=special:agents
CLASS=com.mitchellh.ghostty.agents
LOCK_DIR="${XDG_RUNTIME_DIR:-/tmp}/haoshoku-agents-toggle.lock"

# Hyprland can run duplicate binds close enough together that both instances see no
# agents window yet. Serialize the whole toggle/launch path so only one can spawn.
if ! mkdir "$LOCK_DIR" 2>/dev/null; then
	exit 0
fi
trap 'rmdir "$LOCK_DIR"' 0 HUP INT TERM

# 1. Already on special:agents -> just toggle its visibility.
if hyprctl clients -j | jq -e --arg ws "$WS" 'any(.[]; .workspace.name == $ws)' >/dev/null 2>&1; then
	hyprctl dispatch togglespecialworkspace agents
	exit 0
fi

# 2. An agents window stranded on another workspace -> reclaim it instead of
#    spawning a duplicate.
stray=$(hyprctl clients -j | jq -r --arg c "$CLASS" 'first(.[] | select(.class == $c) | .address) // empty')
if [ -n "$stray" ]; then
	hyprctl dispatch movetoworkspacesilent "$WS,address:$stray"
	hyprctl dispatch togglespecialworkspace agents
	exit 0
fi

# 3. Nothing to reuse -> spawn. The execrule normally places it; the explicit
#    move below covers the window appearing after the rule was evaluated.
hyprctl dispatch exec "[workspace $WS silent] ghostty --class=$CLASS --title=agents -e fish -C 'claude -r io'"

i=0
while [ "$i" -lt 60 ]; do
	addr=$(hyprctl clients -j | jq -r --arg c "$CLASS" 'first(.[] | select(.class == $c) | .address) // empty')
	if [ -n "$addr" ]; then
		hyprctl dispatch movetoworkspacesilent "$WS,address:$addr"
		hyprctl dispatch togglespecialworkspace agents
		exit 0
	fi
	i=$((i + 1))
	sleep 0.1
done
exit 0
