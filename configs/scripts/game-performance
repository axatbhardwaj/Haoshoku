#!/usr/bin/env bash
# Shadow wrapper for /usr/bin/game-performance (cachyos-settings).
# When a game launches through this:
#   - DP-1 (primary gaming monitor) flips to vrr=1
#   - Caelestia gameMode engages (kills animations/blur/gaps, enables tearing)
#   - Real /usr/bin/game-performance handles the CPU governor via powerprofilesctl
# Effects revert on normal exit/termination via trap. A Hyprland startup reset
# handles crash/reboot cases where the trap cannot run.
#
# Resolves before /usr/bin because ~/.local/bin precedes it in $PATH on
# systemd-user-session-managed setups.
#
# Hyprland 0.55.4 applies a targeted monitor keyword to live VRR state without
# reloading every output. A full reload can cause NVIDIA hotplug storms and kill
# Wayland clients, so keep the persistent config at vrr=0 and override DP-1 only
# for the game's lifetime.

set -u

set_dp1_vrr() {
    hyprctl keyword monitor "DP-1,2560x1440@143.97,1080x240,1,vrr,$1" >/dev/null 2>&1
}

revert() {
    set_dp1_vrr 0
    caelestia shell gameMode disable >/dev/null 2>&1
}

if [ "${1:-}" = "--reset" ]; then
    revert
    exit 0
fi

trap revert EXIT HUP INT TERM

set_dp1_vrr 1
caelestia shell gameMode enable >/dev/null 2>&1
# NOT exec — we need the wrapper bash alive so the trap fires on game exit.
/usr/bin/game-performance "$@"
