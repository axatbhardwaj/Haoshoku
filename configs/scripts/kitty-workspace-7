#!/usr/bin/env sh
# Super+7: open workspace 7 and ensure it has one plain kitty window from $HOME.
#
# Occupancy is checked against the whole kitty class family, so a
# terminal opened there by Super+T already satisfies it and no second window is
# spawned. The window this script creates gets its own class suffix purely so it
# can be found again in one lookup; the wait loop remains a placement fallback.
WS=7
CLASS_FAMILY=kitty
CLASS=kitty-workspace-7

if hyprctl clients -j | jq -e --arg ws "$WS" --arg c "$CLASS_FAMILY" \
	'any(.[]; (.class | startswith($c)) and .workspace.name == $ws)' >/dev/null 2>&1; then
	hyprctl dispatch workspace "$WS"
	exit 0
fi

# A window from a previous run stranded elsewhere -> reclaim it.
stray=$(hyprctl clients -j | jq -r --arg c "$CLASS" 'first(.[] | select(.class == $c) | .address) // empty')
if [ -n "$stray" ]; then
	hyprctl dispatch movetoworkspacesilent "$WS,address:$stray"
	hyprctl dispatch workspace "$WS"
	exit 0
fi

hyprctl dispatch exec "[workspace $WS silent] kitty --class=$CLASS --directory=$HOME"

i=0
while [ "$i" -lt 60 ]; do
	addr=$(hyprctl clients -j | jq -r --arg c "$CLASS" 'first(.[] | select(.class == $c) | .address) // empty')
	if [ -n "$addr" ]; then
		hyprctl dispatch movetoworkspacesilent "$WS,address:$addr"
		hyprctl dispatch workspace "$WS"
		exit 0
	fi
	i=$((i + 1))
	sleep 0.1
done

hyprctl dispatch workspace "$WS"
exit 0
