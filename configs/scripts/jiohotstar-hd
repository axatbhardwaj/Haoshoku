#!/usr/bin/env bash
# JioHotstar HD - native Brave app-mode launcher (personal Default profile).
# Same native-Brave pattern as crunchyroll-hd: no Wine bottle, no CDP selector, no
# profile seeding. Routed to special:jiohotstar by the app-id class
# brave-www.jiohotstar.com__-Default (Super+Shift+J via caelestia toggle jiohotstar).
# Note: resolution is whatever JioHotstar serves Linux/Brave (Widevine L3) - it plays
# via the software video path (see ~/.config/brave-flags.conf), not necessarily 1080p.
set -euo pipefail

JH_URL="${JH_URL:-https://www.jiohotstar.com}"

find_brave() {
  if [ -n "${BRAVE_BIN:-}" ]; then
    [ -x "$BRAVE_BIN" ] || command -v "$BRAVE_BIN" >/dev/null 2>&1 \
      || { echo "jiohotstar-hd: BRAVE_BIN is not executable: $BRAVE_BIN" >&2; exit 1; }
    printf '%s\n' "$BRAVE_BIN"; return 0
  fi
  for candidate in /opt/brave-bin/brave brave brave-browser; do
    if [ -x "$candidate" ]; then printf '%s\n' "$candidate"; return 0; fi
    if command -v "$candidate" >/dev/null 2>&1; then command -v "$candidate"; return 0; fi
  done
  echo "jiohotstar-hd: native Brave not found (expected /opt/brave-bin/brave, brave, or brave-browser)" >&2
  exit 1
}

BRAVE="$(find_brave)"
exec "$BRAVE" \
  --profile-directory=Default \
  --no-first-run \
  --no-default-browser-check \
  --app="$JH_URL" \
  "$@"
