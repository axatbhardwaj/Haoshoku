#!/usr/bin/env bash
# primevideo-setup — build the shared Wine-TkG bottle for HD streaming on Linux:
# Windows Brave under Wine-TkG 10.8 via Bottles (native Linux Brave is throttled —
# Prime 540p). Generates launchers for Prime Video and ZEE5. Idempotent — safe to re-run.
#
# It automates the scriptable parts and stops with clear instructions at the two
# steps that cannot be done headlessly:
#   [MANUAL 1] first-time Bottles bottle creation (the component bootstrap is
#              GUI-only — bottles-cli can't download runners/dxvk itself)
#   [MANUAL 2] streaming-service sign-in (+ accept Widevine, then go fullscreen)
#
# Pairs with caelestia keybinds: Super+Shift+P -> special:primevideo, Super+Shift+Z -> special:zee5.
# Full rationale: docs/runbooks/prime-video-hd.html
set -euo pipefail

BOTTLE="primevideo-tkg9"
RUNNER="wine-10.8-staging-tkg-amd64"
RUNNER_URL="https://github.com/Kron4ek/Wine-Builds/releases/download/10.8/wine-10.8-staging-tkg-amd64.tar.xz"
BRAVE_URL="https://github.com/brave/brave-browser/releases/download/v1.91.175/BraveBrowserStandaloneSilentSetup.exe"
BOTTLES_DIR="$HOME/.local/share/bottles"
PFX="$BOTTLES_DIR/bottles/$BOTTLE"
RUNNERS_DIR="$BOTTLES_DIR/runners"
LAUNCHER="$HOME/.local/bin/primevideo-hd"

say()  { printf '\033[1;34m::\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*"; }
die()  { printf '\033[1;31mxx\033[0m %s\n' "$*" >&2; exit 1; }

# 0 — prerequisites
for c in bottles-cli curl tar file; do
  command -v "$c" >/dev/null 2>&1 || die "missing dependency: $c (install Bottles + coreutils)"
done

# 1 — Wine-TkG 10.8 runner (system Wine 11.x crashes Prime on play; soda 9.x is too old)
if [ -x "$RUNNERS_DIR/$RUNNER/bin/wine" ]; then
  say "runner '$RUNNER' already present"
else
  say "fetching Wine-TkG 10.8 runner..."
  mkdir -p "$RUNNERS_DIR"
  tmp="$(mktemp)"
  curl -fL --retry 3 --connect-timeout 20 -o "$tmp" "$RUNNER_URL" || die "runner download failed"
  tar -xJf "$tmp" -C "$RUNNERS_DIR" || die "runner extract failed"
  rm -f "$tmp"
  [ -x "$RUNNERS_DIR/$RUNNER/bin/wine" ] || die "runner missing after extract"
  say "runner installed: $("$RUNNERS_DIR/$RUNNER/bin/wine" --version 2>/dev/null || echo "$RUNNER")"
fi

# 2 — bottle (MANUAL 1 if absent: Bottles' first-run component bootstrap is GUI-only)
if [ -d "$PFX/drive_c" ]; then
  say "bottle '$BOTTLE' exists"
else
  warn "[MANUAL 1] bottle '$BOTTLE' not found."
  warn "  Open Bottles (GUI) and create a new bottle:"
  warn "    Name:        $BOTTLE"
  warn "    Environment: Application   (any default runner — this script swaps it)"
  warn "  Wait for it to finish downloading components, then re-run: primevideo-setup"
  exit 0
fi

# 3 — point the bottle at the TkG runner + Windows 10
bottles-cli edit -b "$BOTTLE" --runner "$RUNNER" --win win10 >/dev/null 2>&1 \
  || warn "couldn't set runner/win via bottles-cli; set Runner=$RUNNER + Windows=win10 in the Bottles GUI"

# 4 — Brave 1.91 (skip if already installed)
BRAVE_EXE="$PFX/drive_c/users/$USER/AppData/Local/BraveSoftware/Brave-Browser/Application/brave.exe"
if [ -f "$BRAVE_EXE" ]; then
  say "Brave already installed in the bottle"
else
  say "downloading + installing Brave 1.91 (silent)..."
  tmp="$(mktemp --suffix=.exe)"
  curl -fL --retry 3 --connect-timeout 20 -o "$tmp" "$BRAVE_URL" || die "Brave download failed"
  file "$tmp" | grep -qi 'PE32' || die "downloaded Brave is not a Windows .exe (bad URL?)"
  bottles-cli run -b "$BOTTLE" -e "$tmp" >/dev/null 2>&1 || warn "installer exited non-zero (often still installs)"
  rm -f "$tmp"
  [ -f "$BRAVE_EXE" ] || die "Brave not found after install — check the bottle in the Bottles GUI"
  say "Brave installed"
fi

# 5 — launchers (one per service; flags required: blank-window + video-crash workarounds)
write_launcher() {  # $1=path  $2=app-url  $3=banner
  say "writing launcher: $1"
  mkdir -p "$(dirname "$1")"
  cat > "$1" <<LAUNCH
#!/usr/bin/env bash
# $3 — Windows Brave under Wine-TkG via Bottles (shared $BOTTLE bottle).
# Generated by primevideo-setup. Native Linux Brave is throttled; go fullscreen for max res.
BOTTLE="$BOTTLE"
BRAVE="\$HOME/.local/share/bottles/bottles/$BOTTLE/drive_c/users/\$USER/AppData/Local/BraveSoftware/Brave-Browser/Application/brave.exe"
exec bottles-cli run -b "\$BOTTLE" -e "\$BRAVE" -- \\
  --no-first-run --no-default-browser-check \\
  --disable-gpu --disable-accelerated-video-decode --disable-gpu-memory-buffer-video-frames \\
  --app=$2
LAUNCH
  chmod +x "$1"
}
write_launcher "$HOME/.local/bin/primevideo-hd" "https://www.primevideo.com" "Prime Video HD (1080p fullscreen)"
write_launcher "$HOME/.local/bin/zee5-hd"       "https://www.zee5.com"       "ZEE5 HD"

# 6 — done; MANUAL 2
say "Setup complete. Launchers: ~/.local/bin/{primevideo-hd,zee5-hd}"
warn "[MANUAL 2] Launch — Prime: Super+Shift+P  ·  ZEE5: Super+Shift+Z  (or run the launchers). Then in Brave:"
warn "  sign in, accept the Widevine prompt, keep Shields OFF for the site,"
warn "  play a title, and GO FULLSCREEN — that's what unlocks max resolution (windowed is throttled)."
say "Verify: F12 -> Console -> Math.max(...[...document.querySelectorAll('video')].map(v=>v.videoHeight))"
