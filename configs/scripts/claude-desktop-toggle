#!/usr/bin/env sh
# Super+I: toggle the native claude-desktop app on a DP-2 special workspace.
#
# This used to pair Claude with a second web-app window as a floating top/bottom
# stack, which is why earlier versions carried monitor-geometry math — reserved
# strips for Caelestia's side bar, plus a transform check because DP-2 is
# rotated. A single window needs none of it: Hyprland tiles it into the work
# area and already honours both. `settiled` reclaims a window that an older
# stacking version left floating at half height.

MONITOR=DP-2
WS=special:claude-desktop
WS_NAME=claude-desktop
LOCK_DIR="${XDG_RUNTIME_DIR:-/tmp}/haoshoku-claude-desktop-toggle.lock"

# Native Anthropic desktop app (pacman: claude-desktop, single-instance).
CLAUDE_CLASS=com.anthropic.Claude
CLAUDE_LAUNCH="app2unit -- claude-desktop"

if ! mkdir "$LOCK_DIR" 2>/dev/null; then
	exit 0
fi
trap 'rmdir "$LOCK_DIR"' 0 HUP INT TERM

clients() {
	hyprctl clients -j
}

window_address() {
	clients | jq -r --arg class "$1" 'first(.[] | select(.class == $class) | .address) // empty'
}

window_on_workspace() {
	clients | jq -e --arg class "$1" --arg ws "$WS" \
		'any(.[]; .class == $class and .workspace.name == $ws)' >/dev/null 2>&1
}

workspace_visible() {
	hyprctl monitors -j | jq -e --arg ws "$WS" \
		'any(.[]; .specialWorkspace.name == $ws)' >/dev/null 2>&1
}

reveal_if_hidden() {
	if ! workspace_visible; then
		hyprctl dispatch togglespecialworkspace "$WS_NAME"
	fi
}

move_existing_window() {
	addr=$(window_address "$1")
	if [ -n "$addr" ]; then
		hyprctl dispatch movetoworkspacesilent "$WS,address:$addr"
		return 0
	fi
	return 1
}

# Idempotent: tiling an already-tiled window is a no-op, so this only matters
# the first time after upgrading from the stacking version.
settle_window() {
	addr=$(window_address "$CLAUDE_CLASS")
	if [ -n "$addr" ]; then
		hyprctl dispatch settiled "address:$addr" >/dev/null 2>&1 || true
	fi
}

ensure_app() {
	class=$1
	launch=$2

	if move_existing_window "$class"; then
		return
	fi

	hyprctl dispatch exec "[workspace $WS silent] $launch"
}

hyprctl dispatch focusmonitor "$MONITOR" >/dev/null 2>&1 || true

if window_on_workspace "$CLAUDE_CLASS"; then
	settle_window
	hyprctl dispatch togglespecialworkspace "$WS_NAME"
	exit 0
fi

ensure_app "$CLAUDE_CLASS" "$CLAUDE_LAUNCH"

i=0
while [ "$i" -lt 80 ]; do
	move_existing_window "$CLAUDE_CLASS" >/dev/null 2>&1 || true

	if window_on_workspace "$CLAUDE_CLASS"; then
		settle_window
		reveal_if_hidden
		exit 0
	fi

	i=$((i + 1))
	sleep 0.1
done

settle_window
reveal_if_hidden
exit 0
