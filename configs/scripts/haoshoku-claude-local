#!/usr/bin/env bash
set -euo pipefail

config="$HOME/.haoshoku.json"
lookup=""
rejected=""
session_name=""
status=""

if [[ -r "$config" ]]; then
  if session_name="$(jq -ser '
    if length == 1
      and (.[0] | type == "object")
      and (.[0].claudeSessionName? | type == "string" and test("\\A[A-Za-z0-9][A-Za-z0-9_-]*\\z"))
    then .[0].claudeSessionName else empty end
  ' "$config" 2>/dev/null)"; then
    if [[ -n "$session_name" ]]; then
      exec claude -r "$session_name"
    fi
  elif ! lookup="$(jq -cs '
    if length != 1 or (.[0] | type != "object") then
      {status: "invalid-config"}
    elif ((.[0] | has("claudeSessionName") | not) or .[0].claudeSessionName == null) then
      {status: "unset"}
    else
      {status: "invalid-value", value: .[0].claudeSessionName}
    end
  ' "$config" 2>/dev/null)"; then
    echo "Ignoring claudeSessionName in ~/.haoshoku.json: the file is not valid JSON. Set claudeSessionName to one name using letters, digits, underscores, or hyphens, or set it to null." >&2
  else
    status="$(jq -r '.status' <<<"$lookup")"
    case "$status" in
      invalid-config)
        echo "Ignoring claudeSessionName in ~/.haoshoku.json: the file must contain exactly one JSON object. Set claudeSessionName there to one name using letters, digits, underscores, or hyphens, or set it to null." >&2
        ;;
      invalid-value)
        rejected="$(jq -c '.value' <<<"$lookup")"
        echo "Ignoring claudeSessionName=$rejected in ~/.haoshoku.json. Set claudeSessionName to one name using letters, digits, underscores, or hyphens, or set it to null." >&2
        ;;
    esac
  fi
fi

exec claude
