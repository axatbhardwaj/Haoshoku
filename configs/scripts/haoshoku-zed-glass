#!/usr/bin/env bash
# Zed transparency uses dotted `background.appearance` in each theme style plus alpha background colours; Hyprland supplies the blur behind transparent windows.
set -euo pipefail

theme_file="$HOME/.config/zed/themes/omazed.json"

if [[ ! -f "$theme_file" ]]; then
	exit 0
fi

if ! command -v jq >/dev/null 2>&1; then
	echo "haoshoku-zed-glass: warning: jq is unavailable; leaving theme unchanged" >&2
	exit 0
fi

theme_dir=$(dirname "$theme_file")
tmp_file=""

cleanup() {
	if [[ -n "$tmp_file" ]]; then
		rm -f "$tmp_file"
	fi
}

trap cleanup EXIT INT TERM HUP

if ! tmp_file=$(mktemp "$theme_dir/.omazed.json.XXXXXX"); then
	echo "haoshoku-zed-glass: warning: could not create a temporary theme file" >&2
	exit 0
fi

# Note: the underscore spelling "background_appearance" is NOT a real Zed setting
# and must not be reintroduced. The dotted theme-style field is the only working mechanism.
# Zed composites surfaces: a docked pane draws its content over panel.background,
# which itself draws over background. Alphas therefore multiply when layers stack,
# so a value that looks moderate alone becomes opaque when stacked. panel.background
# is fully clear and terminal.background is near-clear because other content sits on
# those layers; they are not surfaces viewed on their own.
#
# The agent panel thread view uses editor.background, the same key as the real code
# editor, but it is drawn inside a panel over other translucent layers. The shared
# key therefore leaves roughly 50% wallpaper visible in the editor and roughly 22%
# in the thread view purely through stacking. Zed has no agent-, assistant-, or
# thread-specific style key; this was confirmed against the v0.2.0 theme schema at
# https://zed.dev/schema/themes/v0.2.0.json. panel.background stays fully transparent
# to keep the total stack as thin as possible. Do not tidy or average these tiers:
# their calibrated asymmetry is intentional, not an inconsistency.
if ! jq -e '
  def append_alpha($alpha):
    if type == "string" and test("^#[0-9A-Fa-f]{6}$") then
      . + $alpha
    else
      .
    end;

  def patch_alpha($keys; $alpha):
    reduce $keys[] as $key (.;
      if has($key) then
        .[$key] |= append_alpha($alpha)
      else
        .
      end
    );

  def patch_style:
    .["background.appearance"] = "transparent"
    | patch_alpha([
        "panel.background"
      ]; "00")
    | patch_alpha([
        "terminal.background"
      ]; "0D")
    # elevated_surface.background drives Zed context menus, popups, and dialogs
    # (confirmed by https://zed.dev/schema/themes/v0.2.0.json). Commit 930a8c5
    # deliberately kept this key opaque because translucent menus over code are
    # unreadable; 1A came from unrelated debugging and silently reversed that.
    # CC is the human-chosen compromise: visibly glass but dense enough to read.
    # This is intentionally the densest alpha tier in this file; do not normalise
    # it toward the other lower-alpha tiers in a future edit.
    | patch_alpha([
        "elevated_surface.background"
      ]; "CC")
    | patch_alpha([
        "editor.subheader.background",
        "scrollbar.track.background",
        "tab.inactive_background",
        "toolbar.background"
      ]; "8C")
    | patch_alpha([
        "status_bar.background",
        "tab_bar.background",
        "title_bar.background",
        "surface.background"
      ]; "99")
    | patch_alpha([
        "background",
        "editor.background",
        "editor.gutter.background",
        "element.background",
        "tab.active_background"
      ]; "80")
    | if has("scrollbar.thumb.background") then
      .["scrollbar.thumb.background"] as $thumb
      | .border = $thumb
      | .["border.variant"] = $thumb
    else
      .
    end;

  if type == "object"
    and (.themes | type == "array")
    and all(.themes[]; type == "object" and (.style | type == "object")) then
    .themes |= map(.style |= patch_style)
  else
    error("expected theme entries with style objects")
  end
' "$theme_file" >"$tmp_file"; then
	echo "haoshoku-zed-glass: warning: could not process theme; leaving it unchanged" >&2
	exit 0
fi

mv "$tmp_file" "$theme_file"
tmp_file=""
