#!/usr/bin/env sh
# Super+I: toggle Claude + ChatGPT Brave PWAs on a DP-2 special workspace.

MONITOR=DP-2
WS=special:ai-webapps
WS_NAME=ai-webapps
LOCK_DIR="${XDG_RUNTIME_DIR:-/tmp}/haoshoku-ai-webapps-toggle.lock"

CLAUDE_CLASS=brave-fmpnliohjhemenmnlpbfagaolkdacoja-Default
CLAUDE_APP_ID=fmpnliohjhemenmnlpbfagaolkdacoja
CHATGPT_CLASS=brave-cadlkienfkclaiaibeoongdcgmdikeeg-Default
CHATGPT_APP_ID=cadlkienfkclaiaibeoongdcgmdikeeg

BRAVE=/opt/brave-bin/brave
if [ ! -x "$BRAVE" ]; then
	BRAVE=brave
fi

if ! mkdir "$LOCK_DIR" 2>/dev/null; then
	exit 0
fi
trap 'rmdir "$LOCK_DIR"' 0 HUP INT TERM

clients() {
	hyprctl clients -j
}

window_address() {
	clients | jq -r --arg class "$1" 'first(.[] | select(.class == $class) | .address) // empty'
}

window_on_workspace() {
	clients | jq -e --arg class "$1" --arg ws "$WS" \
		'any(.[]; .class == $class and .workspace.name == $ws)' >/dev/null 2>&1
}

workspace_visible() {
	hyprctl monitors -j | jq -e --arg ws "$WS" \
		'any(.[]; .specialWorkspace.name == $ws)' >/dev/null 2>&1
}

reveal_if_hidden() {
	if ! workspace_visible; then
		hyprctl dispatch togglespecialworkspace "$WS_NAME"
	fi
}

move_existing_window() {
	addr=$(window_address "$1")
	if [ -n "$addr" ]; then
		hyprctl dispatch movetoworkspacesilent "$WS,address:$addr"
		return 0
	fi
	return 1
}

place_stack() {
	claude_addr=$(window_address "$CLAUDE_CLASS")
	chatgpt_addr=$(window_address "$CHATGPT_CLASS")

	if [ -z "$claude_addr" ] || [ -z "$chatgpt_addr" ]; then
		return 1
	fi

	geometry=$(hyprctl monitors -j | jq -r --arg monitor "$MONITOR" '
		first(.[] | select(.name == $monitor)) as $mon |
		if $mon == null then empty
		elif ($mon.transform == 1 or $mon.transform == 3 or $mon.transform == 5 or $mon.transform == 7) then
			[$mon.x, $mon.y, $mon.height, $mon.width, $mon.reserved[0], $mon.reserved[1], $mon.reserved[2], $mon.reserved[3]]
		else
			[$mon.x, $mon.y, $mon.width, $mon.height, $mon.reserved[0], $mon.reserved[1], $mon.reserved[2], $mon.reserved[3]]
		end |
		@tsv
	')

	if [ -z "$geometry" ]; then
		return 1
	fi

	set -- $geometry
	monitor_x=$1
	monitor_y=$2
	monitor_width=$3
	monitor_height=$4
	reserved_left=$5
	reserved_top=$6
	reserved_right=$7
	reserved_bottom=$8

	# Hyprland's reserved strip covers Caelestia's side bar; keep the usual
	# post-reservation gap so the stack matches normal tiled window placement.
	edge_gap=11
	inner_gap=10
	win_x=$((monitor_x + reserved_left + edge_gap))
	win_width=$((monitor_width - reserved_left - reserved_right - edge_gap * 2))
	win_height=$(((monitor_height - reserved_top - reserved_bottom - edge_gap * 2 - inner_gap) / 2))
	claude_y=$((monitor_y + reserved_top + edge_gap))
	chatgpt_y=$((claude_y + win_height + inner_gap))

	hyprctl dispatch setfloating "address:$claude_addr"
	hyprctl dispatch setfloating "address:$chatgpt_addr"
	hyprctl dispatch resizewindowpixel "exact $win_width $win_height,address:$claude_addr"
	hyprctl dispatch movewindowpixel "exact $win_x $claude_y,address:$claude_addr"
	hyprctl dispatch resizewindowpixel "exact $win_width $win_height,address:$chatgpt_addr"
	hyprctl dispatch movewindowpixel "exact $win_x $chatgpt_y,address:$chatgpt_addr"
}

ensure_app() {
	class=$1
	app_id=$2

	if move_existing_window "$class"; then
		return
	fi

	hyprctl dispatch exec "[workspace $WS silent] app2unit -- $BRAVE --profile-directory=Default --app-id=$app_id"
}

hyprctl dispatch focusmonitor "$MONITOR" >/dev/null 2>&1 || true

if window_on_workspace "$CLAUDE_CLASS" && window_on_workspace "$CHATGPT_CLASS"; then
	place_stack >/dev/null 2>&1 || true
	hyprctl dispatch togglespecialworkspace "$WS_NAME"
	exit 0
fi

ensure_app "$CLAUDE_CLASS" "$CLAUDE_APP_ID"
ensure_app "$CHATGPT_CLASS" "$CHATGPT_APP_ID"

i=0
while [ "$i" -lt 80 ]; do
	move_existing_window "$CLAUDE_CLASS" >/dev/null 2>&1 || true
	move_existing_window "$CHATGPT_CLASS" >/dev/null 2>&1 || true

	if window_on_workspace "$CLAUDE_CLASS" && window_on_workspace "$CHATGPT_CLASS"; then
		place_stack >/dev/null 2>&1 || true
		reveal_if_hidden
		exit 0
	fi

	i=$((i + 1))
	sleep 0.1
done

place_stack >/dev/null 2>&1 || true
reveal_if_hidden
exit 0
