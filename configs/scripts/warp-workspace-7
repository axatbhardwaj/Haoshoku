#!/usr/bin/env sh
# Super+7: open workspace 7 and ensure it has one plain Warp window from $HOME.
#
# This intentionally does not use Warp tab configs, URL handlers, named profiles,
# or app-specific routing. The explicit post-spawn move covers Warp's warm-process
# behavior, where Hyprland's [workspace 7] exec rule can miss the new window.
WS=7

if hyprctl clients -j | jq -e --arg ws "$WS" 'any(.[]; .class == "dev.warp.Warp" and .workspace.name == $ws)' >/dev/null 2>&1; then
	hyprctl dispatch workspace "$WS"
	exit 0
fi

before=$(hyprctl clients -j | jq -c '[.[] | select(.class == "dev.warp.Warp") | .address]')
hyprctl dispatch exec "[workspace $WS silent] sh -lc 'cd \"\$HOME\" && exec warp-terminal'"

i=0
while [ "$i" -lt 60 ]; do
	new=$(hyprctl clients -j | jq -r --argjson before "$before" 'first(.[] | select(.class == "dev.warp.Warp" and ((.address) as $a | ($before | index($a)) | not)) | .address) // empty')
	if [ -n "$new" ]; then
		hyprctl dispatch movetoworkspacesilent "$WS,address:$new"
		hyprctl dispatch workspace "$WS"
		exit 0
	fi
	i=$((i + 1))
	sleep 0.1
done

hyprctl dispatch workspace "$WS"
exit 0
