#!/usr/bin/env bash
set -euo pipefail

recipe="${1:-}"
profiles_helper="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/haoshoku-chromium-profiles"

dispatch() {
  hyprctl dispatch "$@" >/dev/null || true
}

has_client() {
  local pattern="$1"
  hyprctl clients -j 2>/dev/null | jq -e --arg pattern "$pattern" 'any(.[]; ((.class // "") | test($pattern; "i")))' >/dev/null 2>&1 || return 1
}

has_client_class() {
  # Return 0/1/2 as data (present/absent/probe failure). Under set -e, call
  # only in a condition or as `has_client_class x || status=$?`; never bare.
  local class="$1" workspace="${2:-}" query="${3:-class}"
  local -a probe_statuses
  local jq_filter
  case "$query" in
    class) jq_filter='any(.[]?; type == "object" and .class == $class)' ;;
    workspace) jq_filter='any(.[]?; type == "object" and .class == $class and ((.workspace.name // "") | tostring) == $workspace)' ;;
    stray) jq_filter='first(.[]? | select(type == "object" and .class == $class and ((.workspace.name // "") | tostring) != $workspace) | .address | select(type == "string" and length > 0)) // false' ;;
  esac
  # Keep the PIPESTATUS capture inside this group. A trailing `|| true` resets
  # PIPESTATUS to 0, making every failed probe report "client present".
  {
    hyprctl clients -j 2>/dev/null | jq -er --arg class "$class" --arg workspace "$workspace" "$jq_filter" 2>/dev/null
    probe_statuses=("${PIPESTATUS[@]}")
  } || true
  if (( probe_statuses[0] != 0 || probe_statuses[1] > 1 )); then
    return 2
  fi
  return "${probe_statuses[1]}"
}

launch() {
  local workspace="$1"
  local launch_command
  shift
  printf -v launch_command '%q ' "$@"
  dispatch exec "[workspace ${workspace} silent] uwsm-app -- $launch_command"
}

launch_if_missing() {
  local workspace="$1" pattern="$2"
  shift 2
  has_client "$pattern" || launch "$workspace" "$@"
}

warp_clients() {
  local clients
  clients="$(hyprctl clients -j 2>/dev/null)" || return 1
  jq -se 'length == 1 and (.[0] | type == "array")' <<<"$clients" >/dev/null 2>&1 || return 1
  printf '%s\n' "$clients"
}

find_owned_warp_addresses() {
  local clients="$1" tag="$2"
  jq -c --arg tag "$tag" '[
    .[]? | select(
      type == "object"
      and .class == "dev.warp.Warp"
      and (.address | type == "string" and length > 0)
      and any(.tags?[]?; . == $tag)
    ) | .address
  ]
  ' <<<"$clients"
}

find_warp_workspace() {
  local clients="$1" address="$2"
  jq -r --arg address "$address" '
    first(.[]? | select(.address == $address) | .workspace.name // empty) // empty
  ' <<<"$clients"
}

find_adoptable_warp_addresses() {
  local clients="$1" workspace="$2"
  jq -c --arg workspace "$workspace" '[
    .[]? | select(
      type == "object"
      and .class == "dev.warp.Warp"
      and (.address | type == "string" and length > 0)
      and ((.workspace.name // "") | tostring) == $workspace
      and (any(.tags?[]?; type == "string" and startswith("haoshoku-")) | not)
    ) | .address
  ]
  ' <<<"$clients"
}

warp_addresses() {
  local clients="$1"
  jq -c '[.[]? | select(
    type == "object"
    and .class == "dev.warp.Warp"
    and (.address | type == "string" and length > 0)
  ) | .address]' <<<"$clients"
}

find_new_warp_addresses() {
  local clients="$1" before_addresses="$2"
  jq -c --argjson before "$before_addresses" '[
    .[]? | select(
      type == "object"
      and .class == "dev.warp.Warp"
      and (.address | type == "string" and length > 0)
      and (.address as $address | $before | index($address) | not)
      and (any(.tags?[]?; type == "string" and startswith("haoshoku-")) | not)
    ) | .address
  ]
  ' <<<"$clients"
}

unique_warp_address() {
  local addresses="$1" count
  count="$(jq -r 'length' <<<"$addresses")" || return 2
  case "$count" in
    0) return 1 ;;
    1) jq -er '.[0] | select(type == "string" and length > 0)' <<<"$addresses" ;;
    *) return 2 ;;
  esac
}

ensure_warp_locked() {
  local workspace="$1" tag="$2" uri="$3" adopt_existing="${4:-false}"
  local clients owned_addresses owned_address owned_workspace
  local adoptable_addresses adoptable_address before_addresses new_addresses new_address
  local attempt candidate_status
  clients="$(warp_clients)" || return 0

  owned_addresses="$(find_owned_warp_addresses "$clients" "$tag")" || return 0
  if owned_address="$(unique_warp_address "$owned_addresses")"; then
    owned_workspace="$(find_warp_workspace "$clients" "$owned_address")"
    [[ "$owned_workspace" == "$workspace" ]] || \
      dispatch movetoworkspacesilent "$workspace,address:$owned_address"
    return 0
  else
    candidate_status=$?
  fi
  [[ "$candidate_status" == 1 ]] || return 0

  if [[ "$adopt_existing" == true ]]; then
    adoptable_addresses="$(find_adoptable_warp_addresses "$clients" "$workspace")" || return 0
    if adoptable_address="$(unique_warp_address "$adoptable_addresses")"; then
      dispatch tagwindow "+$tag" "address:$adoptable_address"
      return 0
    else
      candidate_status=$?
    fi
    [[ "$candidate_status" == 1 ]] || return 0
  fi

  before_addresses="$(warp_addresses "$clients")"
  launch "$workspace" warp-terminal "$uri"
  for attempt in {1..10}; do
    clients="$(warp_clients)" || return 0
    new_addresses="$(find_new_warp_addresses "$clients" "$before_addresses")" || return 0
    if new_address="$(unique_warp_address "$new_addresses")"; then
      dispatch tagwindow "+$tag" "address:$new_address"
      dispatch movetoworkspacesilent "$workspace,address:$new_address"
      return 0
    else
      candidate_status=$?
    fi
    [[ "$candidate_status" == 1 ]] || return 0
    if (( attempt < 10 )); then
      sleep 0.1
    fi
  done
}

ensure_warp() {
  local runtime_dir lock_fd result=0
  runtime_dir="${XDG_RUNTIME_DIR:-}"
  [[ -n "$runtime_dir" && -d "$runtime_dir" ]] || return 0
  command -v flock >/dev/null 2>&1 || return 0
  if ! exec {lock_fd}>"$runtime_dir/haoshoku-warp-ownership.lock"; then
    return 0
  fi
  if ! flock "$lock_fd"; then
    exec {lock_fd}>&-
    return 0
  fi
  ensure_warp_locked "$@" || result=$?
  flock -u "$lock_fd" >/dev/null 2>&1 || true
  exec {lock_fd}>&-
  return "$result"
}

if [[ "$recipe" == numbered || "$recipe" == numbered-login ]]; then
  [[ $# -eq 3 ]] || { echo "usage: haoshoku-special-workspace $recipe WORKSPACE APP" >&2; exit 2; }
  workspace="$2" app="$3"
  if [[ "$recipe" == numbered ]]; then
    dispatch workspace "$workspace"
  fi
  case "$app" in
    steam) launch_if_missing "$workspace" '^[Ss]team$' steam ;;
    discord) launch_if_missing "$workspace" '^(discord|vesktop)$' discord ;;
    communication-numbered)
      launch_if_missing "$workspace" '^teams-for-linux$' teams-for-linux
      launch_if_missing "$workspace" '^(TelegramDesktop|org\.telegram\.desktop)$' Telegram
      ;;
    warp) ensure_warp "$workspace" "haoshoku-ws${workspace}" "warp://action/new_window?path=$HOME" true ;;
    notion)
      # Brave Origin ignores --class under --app and derives the class from the URL instead.
      launch_if_missing "$workspace" '^brave-www\.notion\.so__-Default$' brave-origin --user-data-dir="$HOME/.config/brave-haoshoku/notion" --app=https://www.notion.so/
      ;;
    *) echo "unknown numbered recipe: $app" >&2; exit 2 ;;
  esac
  exit 0
fi

browser_profile=""
browser_toggle=false
follows_focus=false
case "$recipe" in
  browser)
    [[ $# -ge 2 ]] || { echo "usage: haoshoku-special-workspace browser PROFILE_ID [URL ...]" >&2; exit 2; }
    browser_profile="$2"
    urls=("${@:3}")
    ;;
  browser-toggle)
    [[ $# -ge 2 ]] || { echo "usage: haoshoku-special-workspace browser-toggle PROFILE_ID [URL ...]" >&2; exit 2; }
    browser_profile="$2"
    browser_toggle=true
    urls=("${@:3}")
    ;;
  browser-flux) browser_profile=flux; browser_toggle=true; urls=("${@:2}") ;;
  browser-defi) browser_profile=defi; browser_toggle=true; urls=("${@:2}") ;;
esac

if [[ -n "$browser_profile" ]]; then
  [[ -x "$profiles_helper" ]] || { echo "missing haoshoku-chromium-profiles helper" >&2; exit 1; }
  profile_json="$("$profiles_helper" get "$browser_profile" 2>/dev/null || true)"
  [[ -n "$profile_json" ]] || { echo "unknown browser profile: $browser_profile" >&2; exit 2; }
  profile="$(jq -r '.id' <<<"$profile_json")"
  class="$(jq -r '.class' <<<"$profile_json")"
  monitor="$(jq -r '.monitor' <<<"$profile_json")"
  workspace="browser-$profile"
else
  case "$recipe" in
    haki) workspace=haki; monitor=DP-2 ;;
    agents) workspace=agents; monitor=DP-2 ;;
    assistants) workspace=assistants; monitor=DP-2 ;;
    music) workspace=music; monitor=DP-1 ;;
    1password) workspace=1password; monitor=DP-1 ;;
    communication) workspace=communication; monitor=HDMI-A-1 ;;
    stash) workspace=stash; monitor=DP-1 ;;
    x) workspace=x; monitor=DP-2 ;;
    youtube) workspace=youtube; monitor=DP-1; follows_focus=true ;;
    jiohotstar) workspace=jiohotstar; monitor=DP-1; follows_focus=true ;;
    crunchyroll) workspace=crunchyroll; monitor=DP-1; follows_focus=true ;;
    reanime) workspace=reanime; monitor=DP-1; follows_focus=true ;;
    *) echo "unknown workspace recipe: ${recipe:-<empty>}" >&2; exit 2 ;;
  esac
  [[ $# -eq 1 ]] || { echo "usage: haoshoku-special-workspace $recipe" >&2; exit 2; }
fi

load_special_workspace_state() {
  local monitors
  monitors="$(hyprctl monitors -j 2>/dev/null || true)"
  focused_monitor="$(jq -r 'first(.[] | select(.focused == true) | .name) // empty' <<<"$monitors" 2>/dev/null || true)"
  visible_monitor="$(jq -r --arg workspace "special:$workspace" 'first(.[] | select(.specialWorkspace.name == $workspace) | .name) // empty' <<<"$monitors" 2>/dev/null || true)"
  if [[ -n "$focused_monitor" ]] && ! jq -e --arg monitor "$monitor" 'any(.[]; .name == $monitor)' <<<"$monitors" >/dev/null 2>&1; then
    monitor="$focused_monitor"
  fi
  if [[ -n "$browser_profile" || "$follows_focus" == true ]]; then
    monitor="${focused_monitor:-$monitor}"
  fi
}

toggle_special_workspace() {
  [[ -n "$visible_monitor" ]] || dispatch focusmonitor "$monitor"
  dispatch togglespecialworkspace "$workspace"
}

focus_or_toggle_special_workspace() {
  if [[ -z "$visible_monitor" ]]; then
    dispatch focusmonitor "$monitor"
    dispatch togglespecialworkspace "$workspace"
  elif [[ "$visible_monitor" != "$focused_monitor" ]]; then
    dispatch focusmonitor "$visible_monitor"
  else
    dispatch togglespecialworkspace "$workspace"
  fi
}

reveal_special_workspace() {
  [[ -n "$visible_monitor" && "$visible_monitor" == "$focused_monitor" ]] || \
    toggle_special_workspace
}

load_special_workspace_state

if [[ -n "$browser_profile" ]]; then
  probe_status=0
  has_client_class "$class" >/dev/null || probe_status=$?
  case "$probe_status" in
    0) browser_client_state=present ;;
    2) browser_client_state=unknown ;;
    *) browser_client_state=absent ;;
  esac

  if "$browser_toggle" && [[ -n "$visible_monitor" ]] && [[ "$browser_client_state" != absent ]] && (( ${#urls[@]} == 0 )); then
    toggle_special_workspace
    exit 0
  fi

  if [[ "$browser_client_state" == present ]]; then
    if (( ${#urls[@]} )); then
      brave-origin "--user-data-dir=$HOME/.config/brave-haoshoku/$profile" "${urls[@]}" || true
    fi
    reveal_special_workspace
  else
    chromium=(
      brave-origin
      "--user-data-dir=$HOME/.config/brave-haoshoku/$profile"
      "--class=$class"
      "${urls[@]}"
    )
    reveal_special_workspace
    printf -v chromium_command '%q ' "${chromium[@]}"
    dispatch exec "[workspace special:$workspace silent] uwsm-app -- $chromium_command"
  fi
  exit 0
elif [[ "$recipe" == haki || "$recipe" == agents ]]; then
  focus_or_toggle_special_workspace
  case "$recipe" in
    haki) ensure_warp "special:$workspace" haoshoku-haki "warp://tab_config/haki?new_window=true" ;;
    agents) ensure_warp "special:$workspace" haoshoku-agents "warp://tab_config/agents?new_window=true" ;;
  esac
  exit 0
elif [[ "$follows_focus" == true ]]; then
  toggle_special_workspace
else
  focus_or_toggle_special_workspace
fi

case "$recipe" in
  assistants)
    launch_if_missing "special:$workspace" '^com\.anthropic\.Claude$' claude-desktop
    # App windows derive their class from the URL, but this process may own Flux's
    # singleton; --class=chromium-flux makes later plain windows use its registry class.
    launch_if_missing "special:$workspace" '^brave-chatgpt\.com__-Default$' brave-origin --user-data-dir="$HOME/.config/brave-haoshoku/flux" --class=chromium-flux --app=https://chatgpt.com
    ;;
  music) launch_if_missing "special:$workspace" '^[Ss]potify$' spotify ;;
  1password) launch_if_missing "special:$workspace" '^1password$' 1password ;;
  communication)
    launch_if_missing "special:$workspace" '^signal$' signal-desktop
    # Brave Origin ignores --class under --app and derives the class from the URL instead.
    launch_if_missing "special:$workspace" '^brave-web\.whatsapp\.com__-Default$' brave-origin --user-data-dir="$HOME/.config/brave-haoshoku/whatsapp" --app=https://web.whatsapp.com/
    ;;
  stash) ;;
  x) launch_if_missing "special:$workspace" '^brave-x\.com__-Default$' brave-origin --user-data-dir="$HOME/.config/brave-haoshoku/flux" --class=chromium-flux --app=https://x.com/ ;;
  youtube) launch_if_missing "special:$workspace" '^brave-youtube\.com__-Default$' brave-origin --user-data-dir="$HOME/.config/brave-haoshoku/flux" --class=chromium-flux --app=https://youtube.com/ ;;
  jiohotstar) launch_if_missing "special:$workspace" '^brave-www\.jiohotstar\.com__-Default$' brave-origin --user-data-dir="$HOME/.config/brave-haoshoku/flux" --class=chromium-flux --app=https://www.jiohotstar.com/ ;;
  crunchyroll) launch_if_missing "special:$workspace" '^brave-www\.crunchyroll\.com__-Default$' brave-origin --user-data-dir="$HOME/.config/brave-haoshoku/flux" --class=chromium-flux --app=https://www.crunchyroll.com/ ;;
  reanime) launch_if_missing "special:$workspace" '^brave-reanime\.to__home-Default$' brave-origin --user-data-dir="$HOME/.config/brave-haoshoku/flux" --class=chromium-flux --app=https://reanime.to/home ;;
esac
