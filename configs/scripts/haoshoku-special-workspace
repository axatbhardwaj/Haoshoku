#!/usr/bin/env bash
set -euo pipefail

recipe="${1:-}"
profiles_helper="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/haoshoku-chromium-profiles"

has_client() {
  local pattern="$1"
  hyprctl clients -j | jq -e --arg pattern "$pattern" 'any(.[]; ((.class // "") | test($pattern; "i")))' >/dev/null
}

has_client_class() {
  local class="$1"
  hyprctl clients -j | jq -e --arg class "$class" 'any(.[]?; type == "object" and .class == $class)' >/dev/null
}

launch() {
  local workspace="$1"
  shift
  hyprctl dispatch exec "[workspace ${workspace} silent] uwsm-app -- $*" >/dev/null
}

launch_if_missing() {
  local workspace="$1" pattern="$2"
  shift 2
  has_client "$pattern" || launch "$workspace" "$@"
}

if [[ "$recipe" == numbered ]]; then
  [[ $# -eq 3 ]] || { echo "usage: haoshoku-special-workspace numbered WORKSPACE APP" >&2; exit 2; }
  workspace="$2" app="$3"
  hyprctl dispatch workspace "$workspace" >/dev/null
  case "$app" in
    steam) launch_if_missing "$workspace" '^[Ss]team$' steam ;;
    discord) launch_if_missing "$workspace" '^(discord|vesktop)$' discord ;;
    communication-numbered)
      launch_if_missing "$workspace" '^teams-for-linux$' teams-for-linux
      launch_if_missing "$workspace" '^(TelegramDesktop|org\.telegram\.desktop)$' Telegram
      ;;
    notion)
      # Chromium ignores --class under --app and derives the class from the URL instead.
      launch_if_missing "$workspace" '^chrome-www\.notion\.so__-Default$' chromium --user-data-dir="$HOME/.config/chromium-haoshoku/notion" --app=https://www.notion.so/
      ;;
    *) echo "unknown numbered recipe: $app" >&2; exit 2 ;;
  esac
  exit 0
fi

browser_profile=""
browser_toggle=false
case "$recipe" in
  browser)
    [[ $# -ge 2 ]] || { echo "usage: haoshoku-special-workspace browser PROFILE_ID [URL ...]" >&2; exit 2; }
    browser_profile="$2"
    urls=("${@:3}")
    ;;
  browser-toggle)
    [[ $# -ge 2 ]] || { echo "usage: haoshoku-special-workspace browser-toggle PROFILE_ID [URL ...]" >&2; exit 2; }
    browser_profile="$2"
    browser_toggle=true
    urls=("${@:3}")
    ;;
  browser-flux) browser_profile=flux; browser_toggle=true; urls=("${@:2}") ;;
  browser-defi) browser_profile=defi; browser_toggle=true; urls=("${@:2}") ;;
esac

if [[ -n "$browser_profile" ]]; then
  [[ -x "$profiles_helper" ]] || { echo "missing haoshoku-chromium-profiles helper" >&2; exit 1; }
  profile_json="$("$profiles_helper" get "$browser_profile" 2>/dev/null || true)"
  [[ -n "$profile_json" ]] || { echo "unknown browser profile: $browser_profile" >&2; exit 2; }
  profile="$(jq -r '.id' <<<"$profile_json")"
  class="$(jq -r '.class' <<<"$profile_json")"
  monitor="$(jq -r '.monitor' <<<"$profile_json")"
  workspace="browser-$profile"
else
  case "$recipe" in
    agents) workspace=agents; monitor=DP-2 ;;
    claude-desktop) workspace=claude-desktop; monitor=DP-2 ;;
    music) workspace=music; monitor=DP-1 ;;
    1password) workspace=1password; monitor=DP-1 ;;
    communication) workspace=communication; monitor=HDMI-A-1 ;;
    stash) workspace=stash; monitor=DP-1 ;;
    x) workspace=x; monitor=DP-2 ;;
    *) echo "unknown workspace recipe: ${recipe:-<empty>}" >&2; exit 2 ;;
  esac
  [[ $# -eq 1 ]] || { echo "usage: haoshoku-special-workspace $recipe" >&2; exit 2; }
fi

load_special_workspace_state() {
  local monitors
  monitors="$(hyprctl monitors -j)"
  focused_monitor="$(jq -r 'first(.[] | select(.focused == true) | .name) // empty' <<<"$monitors")"
  visible_monitor="$(jq -r --arg workspace "special:$workspace" 'first(.[] | select(.specialWorkspace.name == $workspace) | .name) // empty' <<<"$monitors")"
  if [[ -n "$browser_profile" ]]; then
    monitor="${focused_monitor:-$monitor}"
  fi
}

toggle_special_workspace() {
  [[ -n "$visible_monitor" ]] || hyprctl dispatch focusmonitor "$monitor" >/dev/null
  hyprctl dispatch togglespecialworkspace "$workspace" >/dev/null
}

focus_or_toggle_special_workspace() {
  if [[ -z "$visible_monitor" ]]; then
    hyprctl dispatch focusmonitor "$monitor" >/dev/null
    hyprctl dispatch togglespecialworkspace "$workspace" >/dev/null
  elif [[ "$visible_monitor" != "$focused_monitor" ]]; then
    hyprctl dispatch focusmonitor "$visible_monitor" >/dev/null
  else
    hyprctl dispatch togglespecialworkspace "$workspace" >/dev/null
  fi
}

reveal_special_workspace() {
  [[ -n "$visible_monitor" && "$visible_monitor" == "$focused_monitor" ]] || \
    toggle_special_workspace
}

load_special_workspace_state

if [[ -n "$browser_profile" ]]; then
  if "$browser_toggle" && [[ -n "$visible_monitor" ]]; then
    toggle_special_workspace
    exit 0
  fi

  if has_client_class "$class"; then
    if (( ${#urls[@]} )); then
      chromium "--user-data-dir=$HOME/.config/chromium-haoshoku/$profile" "${urls[@]}"
    fi
    reveal_special_workspace
  else
    chromium=(
      chromium
      "--user-data-dir=$HOME/.config/chromium-haoshoku/$profile"
      "--class=$class"
      "${urls[@]}"
    )
    reveal_special_workspace
    printf -v chromium_command '%q ' "${chromium[@]}"
    hyprctl dispatch exec "[workspace special:$workspace silent] uwsm-app -- $chromium_command" >/dev/null
  fi
  exit 0
fi

focus_or_toggle_special_workspace

case "$recipe" in
  agents) launch_if_missing "special:$workspace" '^haoshoku-agents$' kitty --class haoshoku-agents bash -lc claude ;;
  claude-desktop) launch_if_missing "special:$workspace" '^com\.anthropic\.Claude$' claude-desktop ;;
  music) launch_if_missing "special:$workspace" '^[Ss]potify$' spotify ;;
  1password) launch_if_missing "special:$workspace" '^1password$' 1password ;;
  communication)
    launch_if_missing "special:$workspace" '^signal$' signal-desktop
    # Chromium ignores --class under --app and derives the class from the URL instead.
    launch_if_missing "special:$workspace" '^chrome-web\.whatsapp\.com__-Default$' chromium --user-data-dir="$HOME/.config/chromium-haoshoku/whatsapp" --app=https://web.whatsapp.com/
    ;;
  stash) ;;
  x) launch_if_missing "special:$workspace" '^chrome-x\.com__-Default$' chromium --user-data-dir="$HOME/.config/chromium-haoshoku/flux" --app=https://x.com/ ;;
esac
